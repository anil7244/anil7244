# Copy to .env and fill in. Never commit .env.

# Zerodha Kite Connect (developers.kite.trade -> create app; redirect URL e.g. http://127.0.0.1:8765/callback)
KITE_API_KEY=
KITE_API_SECRET=

# Dhan (web.dhan.co -> My Profile -> Access DhanHQ APIs; token valid 24h)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox (account.upstox.com/developer/apps -> new app; redirect URL must match exactly)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional: where the database, tokens and screenshots are kept (default ./data)
# TJ_DATA_DIR=
